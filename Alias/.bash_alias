#---------------------------------------------------------------------------------------------------
alias cmd_find_identify_large_directories='du -h --max-depth=1 | sort -hr'
alias cmd_find_large_individual_files='find . -type f -exec du -h {} + 2>/dev/null | sort -hr | head -n 20'
alias cmd_list_number_of_files='find . -type f | cut -d/ -f2 | sort | uniq -c | sort -nr | head -n 10'
#---------------------------------------------------------------------------------------------------

#---------------------------------------------------------------------------------------------------
alias cmd_show_cpu="lscpu | grep -E '^Thread|^Core|^Socket|^CPU\('"
alias cmd_show_cpu_model='grep -m 1 'model name' /proc/cpuinfo'
#---------------------------------------------------------------------------------------------------


#---------------------------------------------------------------------------------------------------
# Check available power states
available_states=$(cat /sys/power/state)

# Create aliases if power states are available
if [[ $available_states == *"freeze"* ]]; then
  alias cmd_power_suspend='sudo systemctl suspend'
fi

if [[ $available_states == *"standby"* ]]; then
  alias cmd_power_suspend='sudo systemctl suspend'
fi

if [[ $available_states == *"mem"* ]]; then
  alias cmd_power_suspend='sudo systemctl suspend'
fi

if [[ $available_states == *"disk"* ]]; then
  alias cmd_power_hibernate='sudo systemctl hibernate'
#---------------------------------------------------------------------------------------------------


#---------------------------------------------------------------------------------------------------
alias cmd_show_ip_local='ip addr show'
alias cmd_show_ip_geoloc='curl ipinfo.io'
alias cmd_show_ipv4_global="echo 'Your Ip: `curl -o- -s https://api.ipify.org/`'"
function cmd_show_ipv6_global() {
    printf '──────────── My IP Addresses: ────────────\n'
    printf 'IPv4: '
    curl -4 -s --connect-timeout 2 ifconfig.me || printf 'Not Available'
    printf '\nIPv6: '
    curl -6 -s --connect-timeout 2 ifconfig.me || printf 'Not Available'
    printf '\n─────────────────────────────────────────\n'
}
#---------------------------------------------------------------------------------------------------



#---------------------------------------------------------------------------------------------------
function print_directory_size() {
    sudo du -sh $1
}

function df() {
    command df -h 2>/dev/null |
    {
        read -r header
        echo "$header"
        grep -vE '^/dev/loop|^efivarfs' | sort -k6,6
    } |
    sed -E '
        s/(100%|9[0-9]%)/\x1b[31m&\x1b[0m/g
        s/([[00-8]?[0-9]%)/\x1b2m&\x1b[0m/g
    '
}
